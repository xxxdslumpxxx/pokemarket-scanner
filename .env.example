# Scegli UNO dei due provider Vision AI per riconoscere la carta dalla foto:

# Opzione 1 (Consigliata): Google Gemini Vision
GEMINI_API_KEY=TUA_GEMINI_API_KEY
GEMINI_VISION_MODEL=gemini-2.0-flash

# Opzione 2: OpenAI Vision o qualsiasi endpoint OpenAI-compatible (es. OpenRouter)
# OPENAI_API_KEY=TUA_OPENAI_API_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION_MODEL=gpt-4o-mini

# Opzionale: API key gratuita di pokemontcg.io per rate limit più alto sui dati Cardmarket
# POKEMONTCG_API_KEY=TUA_POKEMONTCG_API_KEY
